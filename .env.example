# Alleen server-side. Nooit met VITE_ prefix gebruiken en nooit committen.
MOLLIE_API_KEY=
MOLLIE_MODE=test
APP_BASE_URL=https://www.stilte-en-draad.nl
MOLLIE_WEBHOOK_URL=https://www.stilte-en-draad.nl/api/mollie/webhook

# Neon pooled PostgreSQL URL, inclusief ?sslmode=require.
DATABASE_URL=
# Optioneel maar aanbevolen voor migraties: Neon direct URL zonder -pooler.
DATABASE_URL_UNPOOLED=

# Eurobedragen met punt en maximaal twee decimalen. Het technische plafond wordt niet als commercieel maximum getoond.
DONATION_MIN_AMOUNT=2.50
DONATION_TECHNICAL_MAX_AMOUNT=10000.00
DONATION_CONFIRM_THRESHOLD=500.00

# Reservering van een uniek werk tijdens de betaalpoging.
RESERVATION_DURATION_MINUTES=15

